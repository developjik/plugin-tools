{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugin-builder/schemas/v1/unified-spec.schema.json",
  "title": "Plugin Builder UnifiedSpec v1.1",
  "type": "object",
  "required": ["specVersion", "name", "version", "description", "targets"],
  "properties": {
    "specVersion": { "enum": ["1.0", "1.1"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
    "description": { "type": "string", "maxLength": 200 },
    "author": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      ]
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "category": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "claude": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "lsp": { "type": "array", "items": { "$ref": "#/$defs/ClaudeLspSpec" } },
        "monitors": { "type": "array", "items": { "$ref": "#/$defs/ClaudeMonitorSpec" } },
        "bin": { "type": "array", "items": { "$ref": "#/$defs/ClaudeBinSpec" } },
        "settings": { "$ref": "#/$defs/ClaudeSettingsSpec" },
        "userConfig": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ClaudeUserConfigOption" } },
        "agentExtras": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ClaudeAgentExtras" } }
      }
    },
    "codex": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "policy": {
          "type": "object",
          "properties": {
            "installation": { "type": "string", "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"] },
            "authentication": { "type": "string" }
          }
        },
        "apps": { "type": "array", "items": { "$ref": "#/$defs/CodexAppSpec" } },
        "features": { "type": "object", "additionalProperties": true },
        "interfaceMeta": { "$ref": "#/$defs/CodexInterfaceMeta" }
      }
    },
    "targets": {
      "type": "array",
      "items": { "enum": ["claude-code","codex","cursor"] },
      "minItems": 1
    },
    "cursor": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "logo": { "type": "string" },
        "displayName": { "type": "string" },
        "publisher": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "commandExtension": { "enum": ["md", "mdc", "markdown", "txt"] },
        "inlineHooks": { "type": "boolean" },
        "inlineMcp": { "type": "boolean" }
      }
    },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/CommandSpec" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/SkillSpec" } },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/AgentSpec" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/RuleSpec" } },
    "hooks": { "type": "array", "items": { "$ref": "#/$defs/HookSpec" } },
    "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/McpSpec" } },
    "displayName": { "type": "string" },
    "composerIcon": { "type": "string" },
    "defaultPrompt": { "type": "array", "items": { "type": "string" } },
    "interface": { "$ref": "#/$defs/CodexInterfaceExtras" }
  },
  "$defs": {
    "CommandSpec": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string" },
        "argsHint": { "type": "string" },
        "body": { "type": "string" },
        "frontmatter": { "type": "object" }
      }
    },
    "SkillSpec": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "description": { "type": "string", "minLength": 20 },
        "body": { "type": "string" },
        "allowed-tools": { "type": "array", "items": { "type": "string" } },
        "disable-model-invocation": { "type": "boolean" },
        "user-invocable": { "type": "boolean" },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "argument-hint": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "codex": { "type": "object" }
      }
    },
    "AgentSpec": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "body": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "disallowedTools": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" }
      }
    },
    "RuleSpec": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "description": { "type": "string" },
        "body": { "type": "string" },
        "alwaysApply": { "type": "boolean" },
        "globs": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "HookSpec": {
      "type": "object",
      "required": ["event", "command"],
      "properties": {
        "event": { "type": "string" },
        "matcher": { "type": "string" },
        "command": { "type": "string" },
        "scriptPath": { "type": "string" },
        "type": { "enum": ["command", "http", "mcp_tool", "prompt", "agent"] },
        "statusMessage": { "type": "string" },
        "url": { "type": "string" },
        "toolName": { "type": "string" },
        "prompt": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "McpSpec": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "transport": { "enum": ["stdio","http","sse"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "url": { "type": "string", "format": "uri" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "stdio" } }, "required": ["transport"] },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "transport": { "enum": ["http", "sse"] } }, "required": ["transport"] },
          "then": { "required": ["url"] }
        }
      ]
    },
    "CodexInterfaceExtras": {
      "type": "object",
      "properties": {
        "logo": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "brandColor": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "CodexInterfaceMeta": {
      "type": "object",
      "description": "Codex Apps Directory publish metadata. Top-level interface block hosts these on .codex-plugin/plugin.json.",
      "properties": {
        "shortDescription": { "type": "string" },
        "longDescription": { "type": "string" },
        "developerName": { "type": "string" },
        "websiteURL": { "type": "string" },
        "privacyPolicyURL": { "type": "string" },
        "termsOfServiceURL": { "type": "string" }
      }
    },
    "CodexAppSpec": {
      "type": "object",
      "required": ["name", "provider"],
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "auth": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "config": { "type": "object", "additionalProperties": true }
      }
    },
    "ClaudeLspSpec": {
      "type": "object",
      "required": ["language", "command"],
      "properties": {
        "language": { "type": "string", "description": "Language id key (e.g. 'go', 'python')" },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "extensionToLanguage": { "type": "object", "additionalProperties": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "initializationOptions": { "type": "object", "additionalProperties": true },
        "settings": { "type": "object", "additionalProperties": true }
      }
    },
    "ClaudeMonitorSpec": {
      "type": "object",
      "required": ["name", "command"],
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string" },
        "description": { "type": "string" },
        "when": { "type": "string" }
      }
    },
    "ClaudeBinSpec": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "Path relative to plugin root. File placed under bin/ at scaffold time." },
        "content": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "ClaudeSettingsSpec": {
      "type": "object",
      "properties": {
        "agent": { "type": "string" },
        "subagentStatusLine": { "type": "string" }
      }
    },
    "ClaudeUserConfigOption": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "enum": ["string", "number", "boolean", "directory", "file"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "required": { "type": "boolean" },
        "default": {},
        "multiple": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "ClaudeAgentExtras": {
      "type": "object",
      "description": "Per-agent frontmatter overlay merged onto top-level agents[name] on emit.",
      "properties": {
        "effort": { "enum": ["low", "medium", "high"] },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "skills": { "type": "array", "items": { "type": "string" } },
        "memory": { "type": "boolean" },
        "background": { "type": "boolean" },
        "isolation": { "enum": ["worktree"] },
        "disallowedTools": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
